{
  // Model Context Protocol (MCP) configuration for VS Code
  "servers": {
    "enghub": {
      "type": "stdio",
      "command": "enghub-mcp",
      "args": ["start"]
    },
    "spark-mcp": {
      "type": "stdio",
      "command": "spark-mcp"
    },
    "wiki-mcp": {
      "type": "stdio",
      "command": "wiki-mcp"
    },
    "ScopeMCP.Local": {
      "type": "stdio",
      "command": "scopemcp-local"
    }
  }
}

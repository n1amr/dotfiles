{
	"servers": {
		"enghub": {
			"type": "stdio",
			"command": "C:\\Program Files\\nodejs\\node.exe",
			"args": [
				"Q:\\.tools\\.npm-global\\node_modules\\@azure-core\\enghub-mcp\\dist\\cli.js",
				"start"
			]
		},
		"ScopeMCP.Local": {
			"type": "stdio",
			"command": "C:\\Users\\amralaa\\.dotnet\\tools\\scopemcp-local.exe",
			"args": []
		},
		"spark-mcp": {
			"type": "stdio",
			"command": "C:\\Program Files\\nodejs\\node.exe",
			"args": [
				"Q:\\.tools\\.npm-global\\node_modules\\@magnetar\\spark-mcp\\build\\index.js"
			]
		},
		"microsoft/azure-devops-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@azure-devops/mcp@latest",
				"msasg",
				"-d",
				"${input:ado_domain}"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		}
	},
	"inputs": [
		{
			"id": "ado_domain",
			"type": "promptString",
			"description": "Repeat to enable specific domains: core, work, work-items, search, test-plans, repositories, wiki, pipelines, advanced-security.",
			"password": false
		}
	]
}